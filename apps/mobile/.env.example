# Copy to .env.local (ignored by Git) and set only what you use.

# Address of the hit-analysis service (contracts/analysis.openapi.yaml). Not a secret: provider
# keys belong on the server. Leave empty to keep analysis off and mark hits manually.
# HTTPS is required; http://127.0.0.1:8000 is allowed only in development builds.
EXPO_PUBLIC_ANALYSIS_URL=
