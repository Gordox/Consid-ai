{
  "expo": {
    "name": "Target Practice",
    "slug": "target-practice",
    "scheme": "target-practice",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111315",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Target Practice lets you choose photos of your target to mark and score hits.",
          "cameraPermission": "Target Practice uses the camera to photograph your target before and after a round."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Target Practice uses the camera to photograph your target before and after a round.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
